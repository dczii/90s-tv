{
  "name": "tv",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "EXPO_TV=1 expo run:android",
    "prebuild:tv": "EXPO_TV=1 expo prebuild --platform android --clean",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
