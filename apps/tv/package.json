{
  "name": "tv",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "EXPO_TV=1 expo run:android",
    "prebuild:tv": "EXPO_TV=1 expo prebuild --platform android --clean",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-secure-store",
          "expo-sqlite",
          "expo-constants",
          "expo-splash-screen",
          "expo"
        ]
      }
    }
  },
  "dependencies": {
    "@littleplay/core": "workspace:*",
    "android-identity": "file:./modules/android-identity",
    "buffer": "^6.0.3",
    "device-time": "file:./modules/device-time",
    "expo": "~57.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86-stable",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-reanimated": "4.5.1",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.10.1",
    "youtube-player": "file:./modules/youtube-player"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "^0.1.6",
    "@types/react": "~19.2.2",
    "dotenv": "^16.6.1",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
