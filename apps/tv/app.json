{
  "expo": {
    "name": "LittlePlay",
    "slug": "littleplay",
    "owner": "danilozabala2",
    "version": "1.2.7",
    "orientation": "landscape",
    "icon": "./assets/tv-icon.png",
    "userInterfaceStyle": "dark",
    "platforms": [
      "android"
    ],
    "splash": {
      "backgroundColor": "#0A101C"
    },
    "android": {
      "package": "com.littleplay.tv",
      "versionCode": 11,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/tv-icon.png",
        "backgroundColor": "#0A101C"
      },
      "splash": {
        "backgroundColor": "#0A101C"
      }
    },
    "plugins": [
      "./plugins/withLittlePlay.js",
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVRequired": true,
          "androidTVBanner": "./assets/tv-banner.png",
          "androidTVIcon": "./assets/tv-icon.png"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "880cc1d7-4168-47f9-8155-2806978135df"
      }
    }
  }
}
